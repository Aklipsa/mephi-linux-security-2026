    1  id
    2  groups
    3  groupadd -f students
    4  useradd -u 1234 -m user1
    5  usermod -aG students user1
    6  passwd user1
    7  chage -M 90 user1
    8  id user1
    9  chage -l user1
   10  find / -perm -4000 -type f 2>/dev/null
